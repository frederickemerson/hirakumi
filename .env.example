# shared
DATABASE_URL=postgres://hirakumi:hirakumi@localhost:5432/hirakumi
PUBLIC_BASE_URL=https://gateway.example.com      # Caddy domain serving the gateway (we use <ip>.sslip.io)
INTERNAL_TOKEN=                                  # bearer for /internal/* routes, at least 16 characters (openssl rand -hex 32)
DEMO_MODE=0
ALLOW_INSECURE_UPSTREAM=0
# gateway
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
GATEWAY_PORT=4021
# MIP-003 start_job is limited to 10/min per client address. Sokosumi's backend and Masumi purchaser nodes call from
# a few shared IPs and sign nothing (start_job has no key or signature), so list their ranges here to give each of
# those addresses 600/min. Comma-separated IPv4/IPv6 CIDRs (a bare IP = /32 or /128); /0 is refused. Empty = off.
START_JOB_TRUSTED_CIDRS=
# Keys sellers give for APIs that need one (header or query). Make a pair with
#   npx pnpm@10.28.1 --filter @hirakumi/gateway upstream-auth-keys
# The web app gets only the public half (it seals each key); the gateway gets only the private half (it opens them).
# Never give the private half to the web app or the coworker. Unset: sellers can't add a key, and APIs that have one are blocked.
# A new pair makes every stored key unreadable, so those sellers must enter their keys again.
# web (set in Vercel)
UPSTREAM_AUTH_PUBLIC_KEY=
# Signs session cookies, at least 32 characters
SESSION_SECRET=
# 1: turns on /api/chat, the seller and coworker message route used when the coworker has no Sokosumi key
CHAT_FALLBACK=
# 1: the sales page says per-job Masumi payments are forwarded to sellers by hand (demo collection wallet)
ESCROW_SWEEP_NOTICE=
# Web: 1 lets sellers list an API by base URL and example requests (no OpenAPI file). Turn it on only after the
# gateway has applied migrations 0014 and 0015 and the new coworker runs: an older coworker can't read those APIs.
# Before 0015 the web app hides the any-API features and says the setup is being updated. Unset = off.
SAMPLES_INTAKE=
# gateway only (docker-compose blanks it for the coworker)
UPSTREAM_AUTH_PRIVATE_KEY=
# masumi payment service
PAYMENT_SERVICE_URL=http://payment-service:3001/api/v1
PAYMENT_SERVICE_TOKEN=
MASUMI_ESCROW_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d
BLOCKFROST_PROJECT_ID=preprod...
REGISTRY_SERVICE_URL=https://registry.masumi.network/api/v1
# managed registry token; empty: registry status checks are skipped
REGISTRY_API_KEY=
# deploy (docker compose interpolation)
# host part of PUBLIC_BASE_URL
PUBLIC_DOMAIN=gateway.example.com
POSTGRES_PASSWORD=                                # local Postgres for the Masumi payment service
# coworker
# one of these: the coworker prefers OpenAI when both are set
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com
SOKOSUMI_COWORKER_API_KEY=                        # empty → dashboard-chat fallback
WEB_BASE_URL=https://hirakumi.vercel.app
GATEWAY_INTERNAL_URL=http://gateway:4021
COWORKER_ONBOARDING_CREDITS=1500
TEST_DATABASE_URL=postgres://hirakumi:hirakumi@localhost:5432/hirakumi_test
# demo sellers (docker compose): admin token for /admin/break, and the X-Hirakumi-Verify codes as {"api_xxx":"hkv_..."}
PRICE_ADMIN_TOKEN=
HIRAKUMI_CHALLENGE=
MIKA_HIRAKUMI_CHALLENGE=
# buyer agent (agents/buyer)
BUYER_MNEMONIC=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
# spend caps in tUSDM micros: any pack, a direct (non-escrow) pack, one Masumi job
MAX_PACK_MICROS=5000000
MAX_DIRECT_MICROS=5000000
MAX_ESCROW_MICROS=5000000
# 1: ask for escrow on every pack and refuse a direct offer
REQUIRE_ESCROW=
# the buyer's own Masumi payment service, for `escrow` (one Masumi job)
BUYER_PAYMENT_SERVICE_URL=
BUYER_PAYMENT_SERVICE_TOKEN=
# Gateway and web: the featured APIs the demo wallet may buy live packs for (comma list). Unset = api_eejiaioyqt.
TRY_LIVE_APIS=api_eejiaioyqt

# Web: demo credit tokens for the public try-it-live page, JSON {"<apiId>":"<pack token>"}. Leave empty to show only the 402 offer.
TRY_CREDIT_TOKENS=
# Pack settlement (apps/gateway). hybrid (default) = the settlement policy picks direct or escrow per purchase and
# the 402 says why; without HIRAKUMI_FEE_ADDRESS and OPERATOR_MNEMONIC or ESCROW_CLOSER_VKH (or without
# BLOCKFROST_PROJECT_ID) it settles every pack direct and reports what it recommended. escrow = every pack locks at
# pack_escrow (needs those settings); direct = every pack pays the seller at purchase.
PACK_MODE=hybrid
# Hybrid thresholds: escrow at or above this pack price, below this 7-day uptime, or for a listing younger than this.
SETTLEMENT_ESCROW_FROM_MICROS=2000000
SETTLEMENT_MIN_UPTIME_PCT=99
SETTLEMENT_MIN_LISTING_DAYS=7
HIRAKUMI_FEE_ADDRESS=
HIRAKUMI_FEE_BPS=300
CLOSE_FEE_BUDGET_LOVELACE=700000
# Contest period between Close and Settle (default 180000 in DEMO_MODE, else 3600000)
CONTEST_PERIOD_MS=
# Signs Close / Raise / Settle; its payment key hash is the datum's `closer`. Unset: the watcher only observes,
# and ESCROW_CLOSER_VKH must name the closer key instead.
OPERATOR_MNEMONIC=
ESCROW_CLOSER_VKH=
