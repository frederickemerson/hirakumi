    "hirakumi/types/Stage": {
      "title": "Stage",
      "description": "Where a pack is in its life.\n\n `Open` = Constr 0 []\n `Closing { accepted, contest_end }` = Constr 1 [accepted, contest_end]",
      "anyOf": [
        {
          "title": "Open",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Closing",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "accepted",
              "description": "Highest IOU count proven on-chain so far.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "contest_end",
              "description": "POSIX ms. Raise is allowed strictly before it, Settle strictly after.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    }
