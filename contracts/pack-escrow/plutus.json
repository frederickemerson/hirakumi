    "hirakumi/types/PackDatum": {
      "title": "PackDatum",
      "description": "Inline datum of a pack lock. Constr 0, fields in this exact order.",
      "anyOf": [
        {
          "title": "PackDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "channel_id",
              "description": "32 bytes. Unique pack id; also the inline-datum tag on payouts.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "receipt_key",
              "description": "32 bytes. The buyer's ed25519 verification key for IOUs.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "buyer_refund",
              "description": "Refund address. Its payment key hash is also the buyer's signing identity.",
              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "seller",
              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "policy_id",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "asset_name",
              "$ref": "#/definitions/cardano~1assets~1AssetName"
            },
            {
              "title": "price_per_call",
              "description": "micros of the pack asset",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_calls",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "rule_hash",
              "description": "32 bytes. sha256 of the published promise. Informational.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "fee_address",
              "$ref": "#/definitions/cardano~1address~1Address"
            },
            {
              "title": "fee_bps",
              "description": "Hirakumi take rate in basis points; clamped to 0..1000 at settlement.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "closer",
              "description": "28 bytes. Payment key hash of Hirakumi's operator wallet.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "contest_period",
              "description": "ms between a Close's upper validity bound and the earliest Settle.\n Values below `min_contest_period` (60 s) are treated as 60 s.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "close_fee_budget",
              "description": "Max lovelace a Settle may take from the buyer for the network fee. Only\n a Settle signed by `closer` or the buyer charges the buyer the fee (and\n must stay within this budget); any other settler pays the fee itself.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "stage",
              "$ref": "#/definitions/hirakumi~1types~1Stage"
            }
          ]
        }
      ]
