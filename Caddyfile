{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Spike/operator tool: registry health-check measurement independent of the gateway.
	handle_path /spike/* {
		reverse_proxy availability-stub:8080
	}

	handle {
		reverse_proxy gateway:4021
	}

	log {
		output stdout
		format console
	}
}

# The demo seller's API (a separate "company" for the demo; Hirakumi proxies to it like any other seller).
price.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy price-api:4100
}
