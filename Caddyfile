# The Hirakumi front door: Caddy gets a certificate for a seller's own hostname (api.seller.com pointed here by
# DNS) on its first request, but only when the gateway's ask endpoint says yes (a front-door host whose _hirakumi
# TXT record was verified). Port 4022 is reachable only inside the compose network.
{
	on_demand_tls {
		ask http://gateway:4022/tls-ask
	}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	handle {
		reverse_proxy gateway:4021
	}

	# Authorization and Cookie are redacted by Caddy itself. These custom headers carry secrets too: the recovery
	# secret and the signed payment re-issue a pack token, close-auth closes an escrow channel.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Hirakumi-Recovery-Secret delete
				request>headers>Payment-Signature delete
				request>headers>X-Payment delete
				request>headers>X-Hirakumi-Close-Auth delete
			}
		}
	}
}

# The demo seller's API (a separate "company" for the demo; Hirakumi proxies to it like any other seller).
price.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy price-api:4100
}

# A second demo seller (sellers/fx-api), for onboarding a fresh listing on camera.
mika.{$PUBLIC_DOMAIN} {
	encode zstd gzip
	reverse_proxy mika-api:4100
}

# Every other hostname: a seller's front door. The gateway answers it by Host (apps/gateway/src/frontDoor.ts) and
# never serves its own routes there. Sites above match first, so this only sees front-door hosts.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy gateway:4021

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Hirakumi-Recovery-Secret delete
				request>headers>Payment-Signature delete
				request>headers>X-Payment delete
				request>headers>X-Hirakumi-Close-Auth delete
			}
		}
	}
}
